// --- Монтаж: профиль, библиотека фонов, кадры ролика (edit-plan) ---

/// Монтажный профиль бренда: правила, по которым режется ролик.
///
/// Правил монтажа как сущности в проекте не было вовсе — всё, что можно было
/// сделать, это переписать промпт сценариста (spec §1.4). Профиль принадлежит
/// приложению (бренду); ролик наследует его и может перебить отдельными полями
/// через Video.editOverrides.
model EditProfile {
  id                         Int      @id @default(autoincrement())
  appId                      Int?
  app                        App?     @relation(fields: [appId], references: [id], onDelete: SetNull)
  name                       String
  description                String?
  isDefault                  Boolean  @default(false)
  /// Правила словами: чередование ведущих, что под кого подставлять, чем
  /// открывать ролик. Уходит в системный промпт монтажного агента.
  editPrompt                 String?
  /// Целевая доля перебивок по хронометражу. 0.4 — решение от 14.08.2026.
  brollRatio                 Float    @default(0.4)
  /// Целевой шаг смены картинки. 1.5-2 с — практика короткого видео (§1.3).
  shotChangeSec              Float    @default(1.8)
  pipEnabled                 Boolean  @default(false)
  /// Угол наложения: top_left | top_right | bottom_left | bottom_right.
  pipPosition                String   @default("bottom_right")
  /// Доля ширины кадра под PiP-окно.
  pipSize                    Float    @default(0.28)
  /// Единственный рычаг оператора против неограниченного расхода на
  /// генерацию картинок фона (ре-ревью 3, Task 5, пункт 1): раньше
  /// `imageGenerationAllowed` в раннере вычислялся из наличия flux-dev в
  /// СТАТИЧЕСКОМ реестре моделей — модель там всегда есть, флаг всегда
  /// `true`, ветка §10 «генерация запрещена → кадр ведущему» в проде мертва.
  /// Потолок в долларах на это поле не вводится — решение владельца бренда,
  /// не платформы; выключатель обязателен, чтобы у оператора вообще была
  /// возможность закрыть эту статью расхода.
  imageGenerationEnabled     Boolean  @default(true)
  /// Разворот решения от 14.08: генеративное видео на фон разрешено ОПЦИЕЙ
  /// профиля и только для кадров от 5 секунд (§7). По умолчанию выключено.
  generativeVideoEnabled     Boolean  @default(false)
  /// Потолок расхода на генеративные фоны в пределах одного ролика.
  generativeVideoBudgetUsd   Float    @default(0.5)
  /// Разрешение генеративного фона — значение из constraints спеки модели.
  /// Потребитель поля — генеративный ФОН кадра (Kling 1.6 t2v/i2v на Replicate,
  /// capability text_to_video/image_to_video), а не аватарная speech_to_video
  /// модель (`p-video-avatar`, формат "720p"/"1080p"). Kling принимает
  /// разрешение только пиксельной строкой; "1080x1920" — вертикаль (9:16,
  /// Reels), она же первой стоит в constraints.resolutions обеих способностей
  /// Kling в model-specs.ts. Ценой это обоснование не подкрепляем: $0.045/с
  /// встречается у обеих моделей по разным причинам (у Kling — устаревшая
  /// заниженная смета, у p-video-avatar — актуальный тариф 1080p) и как довод
  /// только вводит в заблуждение.
  generativeVideoResolution  String   @default("1080x1920")
  /// Пошаговый режим: пайплайн ждёт решения оператора после каждого шага.
  /// Механизм ожидания — план 4 (§9); здесь только сам флаг профиля.
  stepwiseApproval           Boolean  @default(false)
  /// Конкретная версия модели монтажа. Полуавтоматические системы тестируются
  /// на конкретной версии: смена версии молча меняет поведение (§5.2).
  llmModelId                 String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  videos                     Video[]

  @@index([appId, isDefault])
}

/// Библиотека загружаемых фонов: запись экрана, лид-магнит, канал, готовая съёмка.
///
/// Устроена как PresenterSourceClip — файл в хранилище, sha1 для дедупа,
/// перцептивный хэш и история использования для cooldown (§5.2).
model BackgroundClip {
  id              String      @id @default(cuid())
  appId           Int
  app             App         @relation(fields: [appId], references: [id], onDelete: Cascade)
  name            String?
  storageKey      String
  storageProvider String      @default("gcs")
  sha1            String
  mimeType        String?
  /// Размер файла. BigInt, не Int: библиотека фонов — записи экрана и готовая
  /// съёмка, INTEGER (потолок 2 147 483 647) переполняется ровно на 2 ГБ —
  /// тот же дефект уже чинили для PresenterRecording (миграция
  /// 20260821030000_widen_presenter_recording_bytes_to_bigint).
  bytes           BigInt?
  /// null у статичной картинки — её длительность задаёт монтаж.
  durationSec     Float?
  width           Int?
  height          Int?
  /// screen_recording | footage | image
  kind            String      @default("footage")
  tags            String[]
  isActive        Boolean     @default(true)
  usageCount      Int         @default(0)
  lastUsedAt      DateTime?
  /// dHash первого кадра: контроль похожести (PROJECT_CONTEXT §7).
  perceptualHash  String?
  uploadedById    Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  shots           VideoShot[]

  @@unique([appId, sha1])
  @@index([appId, isActive, lastUsedAt])
  @@index([appId, kind])
}

/// Кадр смонтированного ролика.
///
/// Отдельная таблица, а не Json на ролике: она даёт перегенерацию одного кадра
/// без пересборки соседей, идемпотентность шага и аудит стоимости по кадрам
/// (§5.2). Перцептивный хэш кадра здесь не для галочки — при шаге монтажа
/// 1.5-2 с граница кадра почти совпадает с шагом сэмплирования отпечатка
/// ролика, и отдельный проход по готовому файлу становится не нужен.
model VideoShot {
  id               String          @id @default(cuid())
  videoId          Int
  video            Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  /// Позиция на таймлайне. Пара (videoId, order) уникальна.
  order            Int
  startSec         Float
  endSec           Float
  /// Смысловая сцена сценария, которой принадлежит кадр. null — кадр
  /// перебивки, не привязанный к реплике.
  sceneOrder       Int?
  /// presenter | none
  foreground       String          @default("none")
  /// library | image | video | app_screen | none — ПЛАН: что решил шаг
  /// edit_plan (saveShots, после pickBackgroundSource). Шаг shot_background
  /// это поле НЕ переписывает никогда, даже если исполнение деградировало
  /// (потолок §7 исчерпан, ссылка на фон исчезла, отказ провайдера) —
  /// перезапись была бы необратимой: подняли потолок генеративного видео —
  /// а кадр больше не "просит" видео, потому что забыл, что просил. Что
  /// реально снято — см. backgroundActual.
  background       String          @default("none")
  /// library | image | video | app_screen | none — ФАКТ: что реально произвёл шаг
  /// shot_background после потолка §7 и отказов исполнения. null — шаг ещё
  /// не исполнялся для этого кадра (только план). Отдельное поле от
  /// background (ruling ре-ревью Task 4, сомнение Б): без него факт
  /// восстановим только парсингом VideoAsset.prompt, а таблица кадров в UI и
  /// перегенерация одного кадра показывали бы оператору план вместо факта.
  /// В ключ кэша шага НЕ входит — иначе чтение этого поля через сортированный
  /// отпечаток кадров дало бы петлю (шаг сам меняет то, от чего считает свой
  /// кэш).
  backgroundActual String?
  backgroundClipId String?
  backgroundClip   BackgroundClip? @relation(fields: [backgroundClipId], references: [id], onDelete: SetNull)
  /// Скрин приложения как фон: id AppReferenceImage. Отдельным полем, а не
  /// общей ссылкой: у скринов свой жизненный цикл и свой каскад.
  appReferenceId   String?
  appReference     AppReferenceImage? @relation(fields: [appReferenceId], references: [id], onDelete: SetNull)
  /// Смысл кадра словами — из него собирается промпт генерации фона (§7).
  idea             String?
  pipEnabled       Boolean         @default(false)
  /// planned | rendering | completed | failed | degraded
  status           String          @default("planned")
  /// Готовый файл кадра (после фона, lip-sync и композиции).
  assetPath        String?
  costUsd          Float           @default(0)
  perceptualHash   String?
  /// Почему кадр деградировал: исчерпан потолок, фон не нашёлся и т.п.
  degradeReason    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([videoId, order])
  @@index([videoId, startSec])
  @@index([backgroundClipId])
  @@index([appReferenceId])
}

// --- Story-driven scenario models ---

model ScenarioGenerationProfile {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  appId       Int?
  app         App?       @relation(fields: [appId], references: [id], onDelete: SetNull)
  isDefault   Boolean    @default(false)
  settings    Json // ScenarioGenerationProfileData
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  scenarios   Scenario[]

  @@index([appId])
}

model ScenarioFeedback {
  id           Int       @id @default(autoincrement())
  scenarioId   Int?
  scenario     Scenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  videoId      Int?
  uploadId     Int?
  feedbackText String
  sentiment    String? // positive | negative | neutral | mixed
  derived      Json? // ScenarioFeedbackDerived
  source       String    @default("operator") // operator | analytics | review
  createdAt    DateTime  @default(now())

  @@index([scenarioId])
  @@index([videoId])
  @@index([uploadId])
}

model ScenarioMemory {
  id        Int      @id @default(autoincrement())
  appId     Int?
  app       App?     @relation(fields: [appId], references: [id], onDelete: SetNull)
  scope     String   @default("global") // global | app | trend
  scopeId   Int? // trendId if scope=trend
  data      Json // OptimizationMemoryData
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, scope, scopeId])
  @@index([scope])
}

// --- Critic Review — журнал AI-критика, сравнивающего N вариантов сценария ---
//
// Один CriticReview = один проход критика (одна итерация). При rework-цикле
// пишется несколько записей с возрастающим iteration. fullReport хранит
// CriticOutput целиком (массив scores, bestVariant, reasoning) — для UI
// детального отчёта без повторных AI-вызовов.
model CriticReview {
  id               Int      @id @default(autoincrement())
  scenarioId       Int
  scenario         Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  iteration        Int
  variantsReviewed Int
  bestVariantId    Int?
  averageScore     Float
  needsRework      Boolean
  reachedThreshold Boolean
  fullReport       Json
  modelVersion     String
  promptVersion    String
  durationMs       Int
  costEstimate     Float?
  createdAt        DateTime @default(now())

  // Атомарная защита от race condition: только 1 review per (scenarioId, iteration).
  // Параллельные вызовы critic'а на одном scenarioId с одной iteration получат P2002 и gracefully break.
  @@unique([scenarioId, iteration])
  @@index([scenarioId, iteration])
  @@index([scenarioId, createdAt])
}

// --- Favorite prompts — библиотека "лучших практик" на уровне per-scene промтов ---
//
// Маркетолог отмечает удачный VideoAsset.prompt звездой → фиксируется snapshot в promptText.
// При генерации сценария story-architect получает до 5 таких промтов как ОРИЕНТИР (не копия).
// appId=null — универсальный промт, виден всем приложениям.
// sourceVideoAssetId с onDelete:SetNull — при удалении исходного ассета snapshot остаётся.
model FavoritePrompt {
  id                 Int         @id @default(autoincrement())
  userId             Int
  user               ZavodUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId              Int?
  app                App?        @relation(fields: [appId], references: [id], onDelete: SetNull)
  promptText         String // immutable snapshot из VideoAsset.prompt
  sourceVideoAssetId Int?
  sourceVideoAsset   VideoAsset? @relation(fields: [sourceVideoAssetId], references: [id], onDelete: SetNull)
  tags               String[]
  notes              String?
  isPublic           Boolean     @default(true)
  usageCount         Int         @default(0)
  lastUsedAt         DateTime?
  // AI structural pattern analysis (KlingPromptPattern: camera/lighting/actionStructure/mood/motionIntensity)
  // Кешируется фоновым агентом prompt-pattern-extractor; пересчитывается только при ручном rerun.
  aiPatternAnalysis  Json?
  aiAnalyzedAt       DateTime?
  aiAnalysisError    String?
  aiAnalysisAttempts Int         @default(0)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([userId])
  @@index([appId])
  @@index([isPublic, appId])
  @@index([tags], type: Gin)
}

// --- Posting jobs state machine (Social Automation iteration 4 prep) ---
// Independent от Upload: Upload = OAuth API uploads (existing), PostingJob =
// автоматический постинг через Indigo+Playwright. Параллельные системы.

enum PostingJobStatus {
  scheduled
  queued
  preparing
  uploading
  published
  failed
  retry_queued
  cancelled
}

enum PostingErrorCategory {
  auth_failed
  proxy_dead
  network_error
  platform_5xx
  platform_validation
  platform_rate_limit
  content_rejected
  account_locked
  internal_error
  unknown
  // --- Part D: browser automation specific categories ---
  // login_required        — checkPlatformLoginStatus вернул loggedIn=false.
  //                         Не retryable — оператор должен залогиниться через Indigo X desktop.
  // browser_connect_failed — puppeteer.connect упал (automation off / port не открыт).
  //                          Не retryable — нужно фиксить Indigo profile настройки.
  // selector_not_found    — DOM не найден ни одним из fallback селекторов.
  //                          Не retryable — TikTok/YT обновили вёрстку, нужно обновить poster.
  // upload_failed         — page.setInputFiles или processing indicator не дождались.
  //                          Retryable 1 раз (timeout на стороне платформы).
  login_required
  browser_connect_failed
  selector_not_found
  upload_failed
}

model PostingJob {
  id              String         @id @default(cuid())
  videoId         Int
  video           Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)
  socialAccountId Int
  socialAccount   SocialAccount  @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  uploadId        Int?           @unique
  upload          Upload?        @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  runId           Int?
  run             WorkflowRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  pipelineId      Int?
  pipeline        Pipeline?      @relation(fields: [pipelineId], references: [id], onDelete: SetNull)

  status         PostingJobStatus @default(queued)
  scheduledAt    DateTime?
  // sha256(`videoId:socialAccountId:scheduledAtISO|asap`).slice(0, 32)
  idempotencyKey String           @unique
  // Snapshot контента на момент создания job (title/description/hashtags/...).
  // Не редактируется после создания — гарантирует идемпотентность retries.
  contentSnapshot Json
  platform       Platform

  attemptCount Int       @default(0)
  maxAttempts  Int       @default(3)
  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?

  // Результат публикации
  platformPostId  String?
  platformPostUrl String?
  // Платформа выдала warning о modified content / API made changes
  apiMadeWarning  Boolean @default(false)

  // Ошибка последней попытки
  lastError     String?
  errorCategory PostingErrorCategory?
  retryAt       DateTime?
  // --- Part D: диагностика browser automation ---
  // lastErrorPhase = одна из PostingPhase ("session_start" | "cdp_connect" | "login_check" | ...).
  //                  Используется AccountDiagnosticPanel для понимания где упал runner.
  // lastErrorScreenshotKey = storageKey скриншота с момента ошибки (zavodcamp/posting-errors/...).
  //                          UI выдаёт через signed URL.
  lastErrorPhase         String?
  lastErrorScreenshotKey String?

  // --- Phase-level FSM (PR1, аддитивно, nullable) ---
  // Persisted runtime-состояние phase-level FSM YouTube-постинга:
  // { fsmVersion, buildMarker, currentPhase, progress, draftVideoId,
  //   phaseAttempts, classWindows, lastTransitionAt }.
  // Форма: shared/types/youtube-posting-fsm.ts:YouTubePostingStateData.
  // null / отсутствие fsmVersion = job НЕ управляется FSM (legacy-путь) — критично
  // для backward-compat. На момент PR1 НИКТО не пишет в это поле (no-op foundation).
  stateData Json?

  createdById   Int?
  createdBy     ZavodUser? @relation("PostingJobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledById Int?
  cancelledBy   ZavodUser? @relation("PostingJobCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelledAt   DateTime?
  cancelReason  String?

  logs PostingJobLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@index([status, retryAt])
  @@index([socialAccountId, createdAt(sort: Desc)])
  @@index([videoId])
  @@index([runId, pipelineId])
  @@index([retryAt])
}

model PostingJobLog {
  id      String     @id @default(cuid())
  jobId   String
  job     PostingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level   String // 'info' | 'warn' | 'error'
  message String
  data    Json?
  createdAt DateTime @default(now())

  @@index([jobId, createdAt(sort: Desc)])
}

// --- Account Warming Planner (Social Automation iteration 4 — Track E) ---
// Детерминистические ежедневные сессии прогрева для социальных аккаунтов.
// Plan генерируется по seedable RNG (seed = accountId:dayKey), Runner — не в этом треке.

model WarmupSession {
  id              String              @id @default(cuid())
  socialAccountId Int
  socialAccount   SocialAccount       @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  status          WarmupSessionStatus @default(planned)
  scheduledAt     DateTime
  // Формат YYYY-MM-DD UTC. Используется для дедупликации planned/running на дату.
  dayKey          String
  // Seed формата 'accId:YYYY-MM-DD' — гарантирует детерминированность плана.
  seed            String
  // Один из 'new' | 'warming' | 'mature' (классификация на момент генерации).
  ageBucket       String
  // WarmupPlan structured (см. shared/types/warmup.ts).
  plan            Json
  // WarmupExecutionLog[] (заполнит runner в итерации 4).
  executedActions Json?
  startedAt       DateTime?
  finishedAt      DateTime?
  errorMessage    String?
  createdById     Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([socialAccountId, dayKey])
  @@index([socialAccountId, scheduledAt])
  @@index([status, scheduledAt])
}

model WarmupKeywordPool {
  id          String    @id @default(cuid())
  name        String
  appId       Int?
  app         App?      @relation(fields: [appId], references: [id], onDelete: SetNull)
  // 'ru' | 'en' | null — null = универсальный.
  language    String?
  // 'general' | 'tech' | 'lifestyle' | 'fitness' | 'education' | 'music' | ...
  category    String
  // Опционально — привязка к платформе (если null, применяется ко всем).
  platform    Platform?
  keywords    String[]
  hashtags    String[]  @default([])
  isActive    Boolean   @default(true)
  createdById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([appId, isActive])
  @@index([category])
  @@index([platform])
}

// --- Content Uniqueness Pipeline (Track F) ---
// Per-platform уникализированные варианты видео. Кеширование по paramsHash:
// одинаковые параметры → один файл, повторный uniqify бесплатен.
// Disclaimer: сервис меняет только file hash + base metadata, не обходит
// perceptual hashing TikTok/Meta. Реальная защита от детектирования —
// творческая (новый текст хук/CTA, монтажа и т.д.), а не техническая.

model VideoUniqueVariant {
  id          String   @id @default(cuid())
  videoId     Int
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  // Platform enum (tiktok | instagram | youtube). В API endpoint пока разрешаем
  // только 'tiktok' и 'youtube', instagram → 400. Enum целиком оставляем для
  // расширяемости без новой миграции.
  platform    Platform
  // Хэш сериализованных параметров uniqify (sha256 от JSON.stringify({crf, brightness, ...})).
  // Сужаем до 16 hex для удобства имени файла.
  paramsHash  String
  // Полные параметры (UniqifyParams) — для отладки и UI «как уникализировано».
  paramsJson  Json
  // Относительный путь от storage/uploads, формат: `unique-variants/<videoId>/<platform>_<hash>.mp4`.
  filePath    String
  // Публичный URL: `/api/files/unique-variants/<videoId>/<platform>_<hash>.mp4`.
  fileUrl     String
  // SHA-256 содержимого готового файла. Главный sanity-check: должен отличаться от оригинала.
  fileHash    String
  durationSec Float
  fileSize    Int
  // GCS persistent storage: `zavodcamp/unique-variants/{videoId}/{platform}_{paramsHash}.mp4`.
  // filePath/fileUrl остаются для backward compat.
  storageKey  String?
  createdAt   DateTime @default(now())

  @@unique([videoId, platform, paramsHash])
  @@index([videoId])
}

// --- Caption Generator (per-platform метаданные для публикации) ---
// Создаётся CaptionGenerator-нодой pipeline'а или вручную через UI.
// Один Caption на (videoId, platform). При approvedAt != null Upload
// executor подменит placeholder title/description/hashtags на эти значения.
//
// fitsLimits — снимок прохождения validateCaption на момент создания/правки.
// Если оператор отредактирует поля так, что лимит превышен — fitsLimits=false
// и UI покажет предупреждение, approve будет заблокирован.

model Caption {
  id                 String   @id @default(cuid())
  videoId            Int
  video              Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  platform           Platform
  title              String
  description        String?
  hashtags           String[]

  // Validation snapshot (актуализируется при каждой правке)
  charsTitle         Int
  charsHashtagsTotal Int
  fitsLimits         Boolean  @default(true)

  // Generation context
  modelVersion       String
  promptVersion      String   @default("v1")
  generationCost     Float?
  generatedById      Int?     // user или null если pipeline

  // Pipeline tracking (если caption создан в рамках pipeline)
  runId              Int?
  pipelineId         Int?

  // Подтверждение оператором — Upload подменяет поля только при approvedAt != null
  approvedAt         DateTime?
  approvedById       Int?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([videoId, platform])
  @@index([videoId])
  @@index([runId, pipelineId])
}

/// Сохранённое представление списка: набор фильтров, сортировка и состав колонок.
///
/// Три класса, которые нельзя смешивать:
///   system   — «Все», «Новые за 24 часа». Заводятся кодом, не лежат в этой таблице.
///   shared   — рабочие очереди команды. Их правит только роль с соответствующим
///              правом; остальные открывают и сохраняют себе копию.
///   personal — ежедневный инструмент оператора, ownerId обязателен.
///
/// Состав колонок пишется в представление, а не в глобальную настройку: у
/// трендвотчера и у оператора публикации разные наборы колонок в одном разделе.
model SavedView {
  id        Int        @id @default(autoincrement())
  /// Раздел списка: trends, videos, uploads, accounts и т.д.
  section   String
  name      String
  /// shared | personal
  scope     String     @default("personal")
  /// Параметры фильтров и сортировки в том виде, в каком их принимает список.
  query     Json
  /// Состав, порядок и ширины колонок. null — колонки по умолчанию для раздела.
  columns   Json?
  /// У общих представлений хранит автора, у личных — владельца.
  ownerId   Int?
  owner     ZavodUser? @relation("SavedViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([section, scope])
  @@index([ownerId, section])
}
