  // Для других типов (music, voiceover, voiceover_mix, thumbnail, preview) order=0.
  order                    Int              @default(0)
  duration                 Int?
  // GCS persistent storage (см. Video.storageKey). storageKey null пока asset
  // не загружен в bucket; после upload — `zavodcamp/videos/{videoId}/...`.
  storageKey               String?
  storageProvider          String           @default("gcs")
  fileSizeBytes            BigInt?
  fileSha256               String?
  contentType              String?
  createdAt                DateTime         @default(now())
  favoritePromptsFromAsset FavoritePrompt[]
  mediaPredictions         MediaPrediction[]

  @@index([storageKey])
  @@index([videoId, type, order])
}

model VideoGenerationStep {
  id                   Int             @id @default(autoincrement())
  videoId              Int
  video                Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  stepKey              VideoStepKey
  stepIndex            Int
  status               VideoStepStatus @default(pending)
  startedAt            DateTime?
  finishedAt           DateTime?
  inputSnapshot        Json?
  outputSnapshot       Json?
  artifacts            Json?
  attemptCount         Int             @default(0)
  maxAttempts          Int             @default(3)
  estimatedCost        Float?
  actualCost           Float?
  logs                 Json?
  errorMessage         String?
  // fal.ai tracking
  falRequestId         String?
  falEndpoint          String?
  falQueueStatus       String?
  falLogsSnapshot      Json?
  falSubmittedAt       DateTime?
  falCompletedAt       DateTime?
  falCanceledAt        DateTime?
  falWebhookReceivedAt DateTime?
  falResultUrl         String?
  falErrorCode         String?
  falAttemptGroupId    String?
  // Sub-key для итеративной генерации (clip per scene). Reattach срабатывает только
  // если subKey совпадает с сохранённым — иначе новый submit (без двойного списания
  // и без подмены результата от другой сцены тем же step.id).
  falSubKey            String?
  createdAt            DateTime        @default(now())
