model Video {
  id                       Int                   @id @default(autoincrement())
  scenarioId               Int
  scenario                 Scenario              @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  variantId                Int?
  applicationId            Int?
  status                   VideoStatus           @default(pending)
  currentStep              String?
  format                   VideoFormat           @default(portrait)
  filePath                 String?
  fileUrl                  String?
  // GCS persistent storage (Saturn PaaS лишён persistent volume для ./storage,
  // поэтому финальное видео живёт в bucket marketingcamp-creatives под префиксом
  // zavodcamp/. filePath/fileUrl остаются ещё ~2 недели для backward compat —
  // потом отдельная микро-миграция DROP COLUMN).
  storageKey               String?
  storageProvider          String                @default("gcs")
  fileSizeBytes            BigInt?
  fileSha256               String?
  duration                 Int?
  errorMessage             String?
  // Output configuration
  subtitlesEnabled         Boolean               @default(true)
  subtitlesStyle           Json?
  // Brand-safe preset субтитров: tiktok_classic | tiktok_bold_yellow | tiktok_boxed | minimal.
  // null = применяется дефолт рендера (tiktok_classic).
  subtitlePreset           String?
  voiceoverPlan            Json? // VoiceoverPlan structured output
  musicEnabled             Boolean               @default(true)
  musicMood                String?
  musicDuration            Int?
  musicVolume              Float                 @default(0.3)
  musicVolumeWithVoiceover Float                 @default(0.12)
  clipDuration             Int                   @default(5)
  imageCount               Int                   @default(3)
  renderQuality            String                @default("medium")
  targetPlatform           String?
  // Voiceover / TTS configuration
  voiceoverEnabled         Boolean               @default(false)
  voiceoverProvider        String?
  voiceoverModelId         String?
  voiceoverVoiceId         String?
  voiceoverLanguage        String                @default("en")
  voiceoverPacing          String                @default("moderate")
  voiceoverReconciliation  String                @default("extend_scene")
  // Model selection (runtime uses these, not hardcodes)
  imageModelId             String                @default("fal-ai/flux/dev")
  videoModelId             String                @default("fal-ai/kling-video/v3/standard/text-to-video")
  modelStrategy            String                @default("auto")
  generateAudio            Boolean               @default(true)
  /// Маршрут производства, зафиксированный при старте прогона. true — audio-first
  /// (единый трек, транскрипция, монтаж по границам слов). Читается с ролика, а не
  /// из env: смена флага посреди производства не должна собирать половину ролика по
  /// одним правилам, половину по другим.
  editPipeline             Boolean               @default(false)
  // Lip-sync (premium feature, gated by quality preset)
  lipSyncEnabled           Boolean               @default(false)
  lipSyncModelId           String?
  lipSyncCharacterId       String?
  lipSyncCharacter         Character?            @relation("VideoLipSyncCharacter", fields: [lipSyncCharacterId], references: [id], onDelete: SetNull)
  // Job safety
  isLocked                 Boolean               @default(false)
  lockedAt                 DateTime?
  lockedReason             String?
  startedAt                DateTime?
  finishedAt               DateTime?
  // Cost tracking
  totalCostEstimate        Float?
  totalCostActual          Float?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  // --- Pipeline tracking (nullable, for standalone/pipeline separation) ---
  runId                    Int?
  run                      WorkflowRun?          @relation(fields: [runId], references: [id], onDelete: SetNull)
  pipelineId               Int?
  pipeline                 Pipeline?             @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  assets                   VideoAsset[]
  uploads                  Upload[]
  steps                    VideoGenerationStep[]
  mediaPredictions         MediaPrediction[]
  postingJobs              PostingJob[]
  factoryPublications      FactoryPublication[]
  factoryQaReviews         FactoryQualityReview[]
  uniqueVariants           VideoUniqueVariant[]
  captions                 Caption[]
  // External creative source (Google Drive, future YouTube/etc.)
  isExternalCreative       Boolean               @default(false)
  externalSource           String?
  externalSourceId         String?
  driveFile                DriveFile?            @relation("DriveFileVideo")
  driveFileId              String?
  driveCredentialId        Int?
  driveCredential          PipelineCredential?   @relation("VideoDriveCredential", fields: [driveCredentialId], references: [id], onDelete: SetNull)
  // Marketing-grade frame analysis (Stage 2 of Video Analyzer modernization).
  // analysisData — JSON snapshot VideoAnalysisFramePass (см. shared/types/video-analysis.ts).
  // framePassVersion + framePassRunAt — TTL idempotency (default version 'frames-v1', TTL 30 дней).
  // fitScore/fitRationale — насколько креатив подходит для App (audience+geo+platform).
  analysisData             Json?
  framePassVersion         String?
  framePassRunAt           DateTime?
  analysisDurationSec      Float?
  fitScore                 Float?
  fitRationale             String?
  frames                   VideoFrame[]
  /// Монтажный профиль ролика. null — правила берутся из профиля приложения по
  /// умолчанию, а если и его нет — из констант edit-plan/profile.ts.
  editProfileId            Int?
  editProfile              EditProfile?          @relation(fields: [editProfileId], references: [id], onDelete: SetNull)
  /// Переопределения полей профиля на этом ролике. Частичный объект тех же
  /// полей; слияние делает resolveEditProfile.
  editOverrides            Json?
  shots                    VideoShot[]

  @@index([scenarioId, status])
  @@index([status])
  @@index([runId])
  @@index([pipelineId])
  @@index([lipSyncCharacterId])
  @@index([externalSource, externalSourceId])
  @@index([framePassRunAt])
  @@index([storageProvider])
  @@index([editProfileId])
}

/// Per-frame DB row для marketing-grade анализа видео.
