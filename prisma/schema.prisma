model SocialAccount {
  id                  Int                  @id @default(autoincrement())
  appId               Int
  app                 App                  @relation(fields: [appId], references: [id])
  platform            Platform
  displayName         String
  platformUserId      String?
  platformHandle      String?
  accessToken         String?
  refreshToken        String?
  expiresAt           DateTime?
  status              AccountStatus        @default(active)
  // Используется dispatch'ером группы для round-robin отбора (обновляется в executeUploadNode)
  lastPostedAt        DateTime?
  // --- Social Automation foundation (iteration 1) ---
  // Шифрованные login-секреты (AES-256-GCM, формат iv:authTag:ciphertext)
  loginEmail          String?
  loginPassword       String?
  recoveryEmail       String?
  recoveryPhone       String?
  twoFASecret         String?
  // Operator-facing план / заметки (НЕ секрет, в plain)
  notes               String?
  // Метаданные аккаунта
  birthDate           DateTime?
  registrationSource  RegistrationSource?
  // Привязка к прокси (один-ко-многим: один прокси может обслуживать несколько аккаунтов)
  proxyId             String?
  proxy               Proxy?               @relation(fields: [proxyId], references: [id], onDelete: SetNull)
  // Указатель на device profile (DuoPlus / антидетект). Физическая колонка
  // остаётся "indigoProfileId" (Этап 2: @@map/@map rename без DDL).
  deviceProfileId     String?              @map("indigoProfileId")
  // Метод постинга: api (через OAuth токены) или browser_automation (через Indigo+CDP).
  // Default 'api' - обратная совместимость с existing accounts. Оператор явно переключает
  // на browser_automation если у аккаунта нет API access (private TikTok etc).
  postingMethod       SocialPostingMethod  @default(api)
  // --- Part D: login-check status (заполняется POST /api/accounts/:id/check-login) ---
  // null = login-check ещё не запускался. После запуска заполняется триплет:
  //   loginCheckedAt = timestamp когда проверяли
  //   loginCheckedStatus = true/false результат detect login на главной странице
  //   loginCheckedUsername = опционально, если удалось вытащить из DOM @-handle
  loginCheckedAt       DateTime?
  loginCheckedStatus   Boolean?
  loginCheckedUsername String?
  // Прогрев аккаунта
  warmupStatus        WarmupStatus         @default(new)
  lastWarmupAt        DateTime?
  totalPostsPublished Int                  @default(0)
  /// Лимит публикаций площадки на момент последней отправки.
  /// Величину отдаёт только Instagram (content_publishing_limit) и только в
  /// момент публикации — снимок, а не текущее состояние, поэтому рядом лежит
  /// время замера, и интерфейс показывает его возраст.
  publishingQuotaUsage Int?
  publishingQuotaTotal Int?
  publishingQuotaAt    DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  uploads             Upload[]
  groups              AccountGroupMember[]
  styleProfile        AccountStyleProfile?
  deviceProfile       DeviceProfile?
  postingJobs         PostingJob[]
  warmupSessions      WarmupSession[]
  deviceProfileLinks  DeviceProfileAccount[]
  metricsSnapshots    AccountMetricsSnapshot[]
  factoryPublications FactoryPublication[]
  proxyDeepCheckLogs  ProxyDeepCheckLog[]

  @@index([appId, status])
  @@index([appId, platform, status])
  @@index([proxyId])
  @@index([warmupStatus])
  @@index([postingMethod])
}

// --- Apify Account Metrics (Часть C) ---
//
// Снимок метрик профиля соцсети, полученный через Apify profile-scrapers.
// Идемпотентность 24h rolling — повторный fetch в течение суток возвращает
// последний 'ok'-снимок без нового запроса к Apify (если не указан ?force=1).
//
// Денормализация appId сюда НЕ нужна: socialAccount.appId всегда достижим
// одним join'ом, экономия одного поля важнее (snapshot копится много за месяцы).
//
// onDelete: Cascade — при удалении аккаунта снимки удаляются (бессмысленны без него).
model AccountMetricsSnapshot {
  id              String        @id @default(cuid())
  socialAccountId Int
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  fetchedAt       DateTime      @default(now())

  // Core metrics — BigInt для случаев когда счётчик может превысить 2.1B
  // (например, YouTube channel views у крупных каналов)
  followers       BigInt?
  following       BigInt?
  totalViews      BigInt?
  totalLikes      BigInt?
  totalComments   BigInt?
  postsCount      Int? // Миллиарды постов на один аккаунт нереалистичны
  avgViewsPer30d  BigInt?
  engagementRate  Float? // 0..1 из выборки последних N постов

  // Profile metadata (snapshot для истории — bio/avatar могут меняться)
  bio        String?
  avatarUrl  String?
  isVerified Boolean?

  // Observability
  status       String  @default("ok") // 'ok' | 'error'
  errorMessage String?
  // { sampleSize: number, posts: NormalizedPost[], rawSample?: unknown }
  rawData      Json?
  // На будущее — привязка к pipeline run (когда появится metrics node)
  agentRunId   Int?

  @@unique([socialAccountId, fetchedAt])
  @@index([socialAccountId, fetchedAt(sort: Desc)])
  @@index([status])
}

// --- Прокси-инфраструктура (Social Automation iteration 1) ---

model Proxy {
  id                  String             @id @default(cuid())
  label               String
  provider            String? // 'iproyal' | 'proxyempire' | 'mobile_proxy_space' | 'other'
  type                ProxyType
  protocol            ProxyProtocol      @default(http)
  // Зашифрованные credentials (AES-256-GCM)
  host                String
  port                Int
  username            String?
  password            String?
  rotationUrl         String?
  expectedCountry     String?
  expectedCity        String?
  ipv4Only            Boolean            @default(false)
  status              ProxyStatus        @default(unverified)
  lastCheckedAt       DateTime?
  lastCheckResult     Json?
  consecutiveFailures Int                @default(0)
  // Дедупликация Telegram-алёртов: { [reason]: { lastAt: ISO-string, count: number } }
  // reasons: 'leak' | 'consecutive_failures_3' | 'auth_failed' | 'expired'
  alertHistory        Json?
  monthlyTrafficGB    Float?
  expiresAt           DateTime?
  createdById         Int
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  socialAccounts      SocialAccount[]
  healthChecks        ProxyHealthCheck[]
  deepCheckLogs       ProxyDeepCheckLog[]
  deviceProfiles      DeviceProfile[]

  @@index([status])
  @@index([type, status])
  @@index([createdById])
}

/**
 * Уровень C deep proxy check log.
 *
 * Уровень A/B (быстрый probe.ts через Node http-agent) сохраняется в ProxyHealthCheck.
 * Уровень C (реальный Indigo browser + CDP + ifconfig.me inside Chromium) — здесь.
 *
 * Гибридная схема: денормализованные ключевые поля (detectedIp/isLeaking/outcome/
 * proxyActuallyWorking/durationMs/recommendation) + fullResult JSON для drill-down.
 * Это даёт быстрый list/index без JSON parsing, при этом не теряет полную структуру
 * DeepProxyCheckResult.steps для отладки.
 *
 * Уровни A/B и C НЕ shared в одну таблицу потому что:
 *   - A/B частые/дешёвые (>100/день), C редкие/дорогие (<50/неделю)
 *   - shape steps/verdict сильно различается
 *   - JOIN history per proxy естественнее с раздельными таблицами
 *
 * onDelete: Proxy=Cascade (логи бесполезны), SocialAccount/IndigoProfile/User=SetNull
 * (лог сохраняется для аналитики прокси).
 */
model ProxyDeepCheckLog {
  id                    String         @id @default(cuid())
  proxyId               String
  proxy                 Proxy          @relation(fields: [proxyId], references: [id], onDelete: Cascade)

  /** Account c которого был запущен (null если прокси не привязан или account удалён). */
  socialAccountId       Int?
  socialAccount         SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)

  /** Device profile использованный для проверки. Физическая колонка остаётся "indigoProfileId". */
  deviceProfileId       String?        @map("indigoProfileId")
  deviceProfile         DeviceProfile? @relation(fields: [deviceProfileId], references: [id], onDelete: SetNull)

  /** Кто инициировал. SetNull при deactivate user'а. */
  initiatedById         Int?
  initiatedBy           ZavodUser?     @relation("ProxyDeepCheckLogInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)

  /** 'manual' | 'scheduled' | 'account_check'. Резерв на будущее, в MVP только 'manual'. */
  triggeredFrom         String         @default("manual")

  /** 'ok' | 'leak' | 'error' | 'precondition_failed'. */
  outcome               String

  startedAt             DateTime       @default(now())
  finishedAt            DateTime?
  durationMs            Int?

  /** Денормализованные ключевые поля (быстрый list view без JSON parsing). */
  detectedIp            String?
  detectedCountry       String?
  detectedCity          String?
  isLeaking             Boolean?
  matchesProxyExpectation Boolean?
  /** false если упал на любом шаге (profileStart/cdpConnect/pageLoad/ipExtraction/profileStop). */
  proxyActuallyWorking  Boolean        @default(false)
  /** Human-readable recommendation от verdict.recommendation. */
  recommendation        String?

  /** Полная структура DeepProxyCheckResult для drill-down. См. shared/types/deep-proxy-check.ts. */
  fullResult            Json?

  createdAt             DateTime       @default(now())

  @@index([proxyId, createdAt(sort: Desc)])
  @@index([socialAccountId, createdAt(sort: Desc)])
  @@index([outcome, createdAt(sort: Desc)])
}

model ProxyHealthCheck {
  id              String   @id @default(cuid())
  proxyId         String
  proxy           Proxy    @relation(fields: [proxyId], references: [id], onDelete: Cascade)
  checkedAt       DateTime @default(now())
  triggeredBy     String // 'manual' | 'scheduled' | 'pre_session'
  tcpConnectOk    Boolean
  httpProbeOk     Boolean
  detectedIp      String?
  detectedCountry String?
  detectedCity    String?
  latencyMs       Int?
  isLeaking       Boolean?
  errorCategory   String? // 'timeout' | 'connection_refused' | 'auth_failed' | 'leak' | 'unknown'
  errorMessage    String?
  rawProbeData    Json?

  @@index([proxyId, checkedAt(sort: Desc)])
}

// --- Device profiles (Social Automation iteration 2 → Этап 2 DuoPlus-нейтрализация) ---
// Зеркало профилей устройства (Indigo legacy → DuoPlus Android cloud phone).
// socialAccountId связывает 1:1 с SocialAccount, proxyId — с Proxy.
// config: opaque snapshot полной схемы провайдера для стабильности при расширении.
// Этап 2: Prisma-модель переименована (DeviceProfile), физ. таблица остаётся
// "IndigoProfile" через @@map — rename без DDL, ноль риска для данных.
// enum IndigoSyncStatus НЕ переименован (Prisma @@map не работает на enum →
// был бы ALTER TYPE на проде). TS-alias DeviceSyncStatus добавлен в shared/коде
// на Этапе 5. Физический rename enum — Этап 3.

enum IndigoSyncStatus {
  synced // в нашей БД и в Indigo
  local_only // создан у нас, ещё не запушен в Indigo
  remote_only // существует в Indigo но не привязан в нашей БД
  conflict // изменения в обоих местах
  deleted_remote // удалён в Indigo
  error
  archived // soft-delete оператором, sync пропускает, не показывается в UI
}

model DeviceProfile {
  id                   String           @id @default(cuid())
  // External (provider side). NULL допустим для local_only до push в провайдер.
  indigoId             String?          @unique
  indigoFolderId       String?
  // Linkage. socialAccountId — denormalized "primary account" указатель
  // (после M.1 multi-account). Оставлен для backwards compat с 26 файлами
  // сервера. Реальные привязки — через DeviceProfileAccount[].
  socialAccountId      Int?             @unique
  socialAccount        SocialAccount?   @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  // Multi-account 1:N (Цикл M). isPrimary=true элемент = primary, его id
  // зеркалится в socialAccountId выше через addAccount/removePrimary логику.
  accounts             DeviceProfileAccount[]
  proxyId              String?
  proxy                Proxy?           @relation(fields: [proxyId], references: [id], onDelete: SetNull)
  // Configuration snapshot
  name                 String
  platformType         String           @default("desktop") // 'desktop' | 'mobile_android' | 'mobile_ios'
  os                   String? // 'Windows 10' | 'macOS' | 'Android 13'
  userAgent            String?
  screenResolution     String? // '1920x1080' | '390x844'
  language             String? // 'en-US'
  timezone             String? // 'America/New_York'
  // Полная конфигурация Indigo (fingerprint/parameters/storage/...) — opaque snapshot
  config               Json?
  // Status
  syncStatus           IndigoSyncStatus @default(local_only)
  lastSyncedAt         DateTime?
  lastSyncError        String?
  // Sessions tracking
  totalSessions        Int              @default(0)
  lastSessionStartedAt DateTime?
  lastSessionEndedAt   DateTime?
  lastSessionPort      Int?
  // Metadata
  notes                String?
  tags                 String[]         @default([])
  createdById          Int?
  proxyDeepCheckLogs   ProxyDeepCheckLog[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  // Физ. таблица остаётся "IndigoProfile" — rename без DDL (Этап 2).
  @@map("IndigoProfile")
  @@index([syncStatus])
  @@index([socialAccountId])
  @@index([proxyId])
}

// DeviceProfileAccount (Цикл M) — 1:1:1 связка между DeviceProfile, SocialAccount и Proxy.
// @@unique([profileId]) — один профиль устройства = максимум один аккаунт (защита от
// мульти-аккаунт конфигураций, ведущих к бану). isPrimary=true всегда (вырождается при 1:1),
// дублируется в DeviceProfile.socialAccountId (denorm) для backwards compat.
// addedAt/addedById — audit trail. Физ. таблица остаётся "IndigoProfileAccount" (@@map, без DDL).
model DeviceProfileAccount {
  id              String        @id @default(cuid())
  profileId       String
  profile         DeviceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  socialAccountId Int
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  isPrimary       Boolean       @default(true)
  addedAt         DateTime      @default(now())
  addedById       Int?

  @@map("IndigoProfileAccount")
  @@unique([profileId])
  @@unique([profileId, socialAccountId])
  @@index([socialAccountId])
  @@index([profileId, isPrimary])
}

