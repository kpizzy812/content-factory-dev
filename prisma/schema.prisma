generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RolePreset {
  admin
  producer
  operator
  analyst
  observer
}

model ZavodUser {
  id               Int               @id @default(autoincrement())
  externalId       Int               @unique
  email            String            @unique
  name             String?
  surname          String?
  // Локальный пароль. null у учёток, которые логинятся внешним провайдером.
  passwordHash     String?
  rolePreset       RolePreset        @default(operator)
  roleName         String?
  rolePresetName   String?
  canRead          Boolean           @default(true)
  canWrite         Boolean           @default(false)
  canCreate        Boolean           @default(false)
  canDelete        Boolean           @default(false)
  canApprove       Boolean           @default(false)
  canRunAgent      Boolean           @default(false)
  canApplyChanges  Boolean           @default(false)
  canAdmin         Boolean           @default(false)
  moduleAccess     String[]
  appAssignments   UserAppAssignment[]
  telegramChatId   String?
  isActive         Boolean           @default(true)
  lastLoginAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  favoritePrompts  FavoritePrompt[]
  secretAccessLogs SecretAccessLog[]
  postingJobsCreated   PostingJob[] @relation("PostingJobCreatedBy")
  postingJobsCancelled PostingJob[] @relation("PostingJobCancelledBy")
  driveFiles           DriveFile[]  @relation("DriveFilesOwner")
  proxyDeepCheckLogsInitiated ProxyDeepCheckLog[] @relation("ProxyDeepCheckLogInitiator")
  savedViews           SavedView[]  @relation("SavedViewOwner")
}

model UserAppAssignment {
  id          Int      @id @default(autoincrement())
  userId      Int
  appId       Int
  appName     String
  accessLevel String   @default("none")
  accounts    String   @default("all")
  geos        String   @default("all")
  permissions String   @default("read")
  syncedAt    DateTime @default(now())

  user ZavodUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, appId])
  @@index([userId])
}

enum TrendStatus {
  new
  reviewed
  in_work
  completed
  dismissed
}

enum Platform {
  tiktok
  instagram
  youtube
}

enum AccountStatus {
  active
  expired
  revoked
}

enum ProxyType {
  mobile
  residential
  datacenter
}

enum ProxyProtocol {
  http
  https
  socks5
}

enum ProxyStatus {
  unverified
  healthy
  degraded
  dead
  expired
}

enum WarmupStatus {
  new
  warming
  ready
  cold
}

enum WarmupSessionStatus {
  planned
  running
  completed
  partial
  failed
  cancelled
  skipped
}

enum RegistrationSource {
  self
  purchased
  transferred
}

enum SocialPostingMethod {
  // Постинг через official API платформы (TikTok Business / YouTube Data / Instagram Graph).
  // Требует OAuth токены, ограничен типом аккаунта (TikTok Business только верифицированным).
  api
  // Постинг через Indigo X browser + Playwright/CDP automation. Работает с любым типом
  // аккаунта (private TikTok / personal Instagram), требует cookies snapshot + login flow.
  // Анти-detect через Indigo fingerprint + proxy.
  browser_automation
}

enum CycleStatus {
  pending
  running
  completed
  failed
  stopped
}

enum AgentLogLevel {
  info
  warn
  error
}

enum UploadStatus {
  pending
  uploading
  published
  failed
  scheduled
  canceled
  blocked_by_env
}

enum PostStatus {
  active
  deleted
  blocked
}

model App {
  id          Int      @id @default(autoincrement())
  externalId  Int?     @unique
  name        String
  description String?
  keywords    String[]
  geo         String?
  language    String?

  // --- Store URLs ---
  appStoreUrl    String?
  playStoreUrl   String?
  storePlatforms String[] // ["ios", "android"]

  // --- Public metadata (from store / manual) ---
  productName        String? // публичное название в магазине
  subtitle           String? // подзаголовок / short description
  longDescription    String? // полное описание из store
  developer          String? // разработчик / издатель
  categories         String[] // категории
  targetAudience     String? // целевая аудитория
  pricingNotes       String? // модель монетизации, IAP, подписки
  iconUrl            String? // URL иконки
  screenshotUrls     String[] // URL скриншотов
  heroImageUrl       String? // hero / feature graphic
  referenceImageUrls String[] // пользовательские reference-картинки для пайплайна (storage/app-references/{id}/...)

  // --- AI-enriched context (editable) ---
  featureBullets        String[] // ключевые фичи / value propositions
  asoKeywords           String[] // ASO-термины
  onboardingSummary     String? // краткое описание онбординга / use-case
  aiSummary             String? // AI-сводка для креативного использования
  brandTone             String? // тон бренда
  visualCues            String? // визуальные подсказки
  forbiddenClaims       String[] // запрещённые утверждения
  riskyClaims           String[] // рискованные утверждения
  creativeAngles        Json? // рекомендованные креативные углы (structured)
  transformationPromise String? // обещание трансформации продукта
  corePain              String? // ключевая боль пользователя
  coreOutcome           String? // ключевой результат
  scenarioContext       Json? // scenario-ready AI context (structured)

  // --- Enrichment status ---
  enrichmentStatus String? // idle | pending | running | completed | failed | partial
  lastEnrichedAt   DateTime?
  enrichmentError  String?

  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  trends               Trend[]
  socialAccounts       SocialAccount[]
  accountGroups        AccountGroup[]
  cycles               ProductionCycle[]
  ideas                Idea[]
  trendwatcherProfiles TrendwatcherProfile[]
  enrichmentLogs       AppEnrichmentLog[]
  generationProfiles   ScenarioGenerationProfile[]
  editProfiles         EditProfile[]
  backgroundClips      BackgroundClip[]
  scenarioMemories     ScenarioMemory[]
  favoritePrompts      FavoritePrompt[]
  referenceImages      AppReferenceImage[]
  warmupKeywordPools   WarmupKeywordPool[]
  characters           Character[]
  scenes               Scene[]
  leadMagnets          LeadMagnet[]
  contentFunnels       ContentFunnel[]
  contentHypotheses    ContentHypothesis[]
  factoryPublications  FactoryPublication[]
  factoryQaReviews     FactoryQualityReview[]
}

// --- Character Library (F1) — per-app reference-персонажи для консистентной генерации ---
//
// Персонаж = имя + описание + теги + 1-line visualPrompt-инжектор + набор референс-изображений
// (лицо/тело/одежда/поза). Используется в SceneComposer-блоках type:'character' для
// подстановки CharacterReferenceImage[] в pipeline видео-генерации (Wan/fal.ai image-to-video).
// archived=true вместо hard-delete: сцены могут на персонажа ссылаться, soft-delete сохраняет
// историю.

model Character {
  id              String                    @id @default(cuid())
  appId           Int
  app             App                       @relation(fields: [appId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  // Роль для UI / композитора: protagonist (главный) | support (второстепенный) | extra (фон/массовка).
  role            String                    @default("protagonist")
  // Короткий 1-line injection в финальный промпт сцены — например, "30y woman, blue jacket, short hair".
  // Если null — composer fallback'ится на description (полное предложение).
  visualPrompt    String?
  tags            String[]
  emotionDefault  String?
  ageRange        String?
  // Голос ведущего: клон обучен на ЕГО записи и осмыслен только рядом с его
  // лицом, поэтому живёт на персонаже, а не на ролике. Ролик наследует
  // (`resolvePresenterVoice`), явный выбор оператора главнее.
  // Модель хранится рядом не для симметрии: клон обучается ПОД конкретную
  // модель, и тот же voiceId в другой модели не существует.
  voiceId         String?
  voiceModelId    String?
  archived        Boolean                   @default(false)
  createdById     Int?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  referenceImages CharacterReferenceImage[]
  sourceClips     PresenterSourceClip[]
  recordings      PresenterRecording[]
  lipSyncVideos   Video[]                   @relation("VideoLipSyncCharacter")

  @@index([appId, archived])
  @@index([appId, name])
  @@index([tags], type: Gin)
}

// Референс-изображения персонажа. kind определяет назначение (face/body/outfit/pose/other),
// composer выбирает релевантный kind в зависимости от ракурса сцены. sha1 (первые 16 hex) —
// dedup-ключ на уровне characterId; повторная загрузка той же картинки не создаёт дубликат.
// GCS path: `zavodcamp/apps/{appId}/characters/{characterId}/{sha1}.{ext}`.
// AI-разметка через character-photo-analyzer (vision Anthropic): теги внешности +
// расширенный visualDescription, который инжектится в video prompt для консистентного героя.
model CharacterReferenceImage {
  id                  String    @id @default(cuid())
  characterId         String
  character           Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  kind                String    @default("face")
  fileUrl             String
  storageKey          String?
  storageProvider     String    @default("gcs")
  sha1                String
  mimeType            String?
  bytes               Int?
  width               Int?
  height              Int?
  order               Int       @default(0)
  uploadedById        Int?
  createdAt           DateTime  @default(now())
  // AI vision analysis: ["young_adult", "short_hair", "blue_jacket", "smile"]
  aiTags              String[]  @default([])
  // 1-2 предложения с описанием персонажа на фото
  aiCaption           String?
  // Расширенный визуальный prompt-инжектор для генерации видео (EN)
  aiVisualDescription String?
  aiAnalyzedAt        DateTime?
  aiError             String?
  aiAttempts          Int       @default(0)
  // Метаданные генерации через fal.ai (NULL для ручной загрузки)
  generationPrompt    String?
  generationModel     String?
  generationCostUsd   Decimal?  @db.Decimal(10, 6)
  // Ротация портретов для AI-аватара (PROJECT_CONTEXT §7): один и тот же кадр,
  // оживлённый во всех сценах и роликах, — это «меняются только губы».
  // Считается так же, как использование фрагментов ведущего в PresenterSourceClip.
  usageCount          Int       @default(0)
  lastUsedAt          DateTime?

  @@unique([characterId, sha1])
  @@index([characterId, kind, order])
  @@index([aiAnalyzedAt])
  @@index([characterId, usageCount, lastUsedAt])
}

// Эталонные кадры сцены (по UX зеркалит AppReferenceImage + CharacterReferenceImage).
// Загружаются прямо в композитор сцены — это "примеры кадра, как должно получиться",
// AI пересобирает из них mood/lighting/camera-angle и инжектит в финальный prompt.
// GCS path: `zavodcamp/apps/{appId}/scenes/{sceneId}/refs/{sha1}.{ext}`.
model PresenterSourceClip {
  id              String    @id @default(cuid())
  characterId     String
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name            String?
  fileUrl         String
  storageKey      String?
  storageProvider String    @default("gcs")
  sha1            String
  mimeType        String?
  bytes           Int?
  durationSec     Float
  width           Int?
  height          Int?
  tags            String[]
  outfit          String?
  background      String?
  gesture         String?
  isActive        Boolean   @default(true)
  usageCount      Int       @default(0)
  lastUsedAt      DateTime?
  uploadedById    Int?
  // dHash первого кадра: контроль похожести исходников (PROJECT_CONTEXT §7).
  perceptualHash  String?
  // Происхождение при автонарезке длинной записи.
  sourceRecording String?
  sourceStartSec  Float?
  /// Запись-родитель. null у клипов, залитых до появления PresenterRecording, —
  /// они продолжают подбираться прежним путём по длительности.
  recordingId     String?
  recording       PresenterRecording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([characterId, sha1])
  @@index([characterId, isActive, lastUsedAt])
  @@index([characterId, perceptualHash])
  @@index([recordingId])
}

/// Длинная исходная запись ведущего, нормализованная и сохранённая целиком.
///
/// До 17.08.2026 запись жила во временном каталоге запроса и удалялась вместе с
/// ним: падение ingest на середине означало повторную заливку до двух гигабайт,
/// а перенарезка библиотеки по новым правилам была невозможна в принципе.
/// Хранение записи — условие нарезки фрагмента под фактическую длину реплики
/// (spec 2026-08-16-audio-first-editing §6.1).
model PresenterRecording {
  id              String    @id @default(cuid())
  characterId     String
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// Нормализованный файл: H.264, 30 fps, AAC, 1920 по большей стороне.
  storageKey      String
  storageProvider String    @default("gcs")
  /// sha1 ОРИГИНАЛА до нормализации: повторная заливка того же файла не создаёт
  /// вторую запись, даже если нормализация даст другие байты.
  sha1            String
  durationSec     Float
  fps             Float?
  width           Int?
  height          Int?
  /// Размер нормализованного файла. BigInt: Minor 3 финального ревью — приём
  /// ограничен MAX_FILE_BYTES = 2 GiB (source-recordings/index.post.ts), то
  /// есть originalBytes переполнял бы INTEGER (потолок 2 147 483 647) ровно на
  /// границе приёма, а нормализованный файл переступает 2 ГБ уже на ~60
  /// минутах записи при 30-37 МБ/мин. saveRecording падал бы на create молча.
  bytes           BigInt?
  originalName    String?
  originalBytes   BigInt?
  /// keep — защищено от автоочистки вручную; auto — попадает под неё.
  retention       String    @default("auto")
  /// pending | running | completed | failed. Позволяет перезапустить нарезку
  /// без повторной заливки.
  ingestStatus    String    @default("pending")
  ingestError     String?
  ingestStartedAt DateTime?
  ingestFinishedAt DateTime?
  /// Момент перевода в холодный класс хранения. null — файл ещё горячий.
  cooledAt        DateTime?
  uploadedById    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  clips           PresenterSourceClip[]
  usages          PresenterRecordingUsage[]

  @@unique([characterId, sha1])
  @@index([characterId, retention, createdAt])
  @@index([ingestStatus])
  /// Под ГЛОБАЛЬНЫЙ (не по characterId) проход автоочистки
  /// (applyRecordingRetention, recording-retention.ts): прежний
  /// [characterId, retention, createdAt] для него бесполезен — characterId
  /// там ведущая колонка, а в этом проходе фильтра по characterId нет.
  /// Important из финального ревью: заводится вместе с сужением `where` до
  /// строк, которые правило вообще способно перевести в новое состояние —
  /// до сужения этот индекс был бы бесполезен, теперь покрывает и фильтр
  /// (retention), и ORDER BY (createdAt) обеих OR-веток.
  @@index([retention, createdAt])
}

/// Использованный интервал записи.
///
/// Пока единицей был готовый клип, cooldown держался на PresenterSourceClip.
/// При нарезке по требованию единица — произвольное окно записи, у которого
/// счётчика нет: без этой таблицы требование docs/PROJECT_CONTEXT.md §7
/// («cooldown повторного использования фрагмента») перестаёт выполняться ровно
/// там, где включается главная фича.
model PresenterRecordingUsage {
  id          String             @id @default(cuid())
  recordingId String
  recording   PresenterRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  startSec    Float
  endSec      Float
  videoId     Int?
  /// Позиция сцены в ролике, под которую занято окно. Вместе с videoId — ключ
  /// идемпотентности резервирования: повторный прогон той же сцены получает
  /// то же окно, а не занимает новое (иначе ретраи выедают свободные участки
  /// записи, и два ролика получают один и тот же кадр — docs/PROJECT_CONTEXT.md §7).
  sceneIndex  Int?
  /// dHash первого кадра вырезанного окна — перцептивный контроль похожести
  /// между РАЗНЫМИ окнами одной записи (server/utils/presenter/perceptual-hash.ts),
  /// тот же принцип, что уже есть на ingest (PresenterSourceClip.perceptualHash).
  frameHash   String?
  usedAt      DateTime           @default(now())

  /// В Postgres несколько NULL в уникальном индексе разрешены, поэтому
  /// служебные резервирования без ролика (videoId: null) друг другу не мешают.
  @@unique([videoId, sceneIndex])
  /// Расширяет прежний индекс (recordingId, usedAt) третьей колонкой frameHash.
  /// planRecordingWindow (запрос по ОДНОМУ recordingId) получает честный
  /// выигрыш — диапазон и выборка целиком из индекса. Запрос "недавние хэши
  /// персонажа" (recording-window-frame-guard.ts) идёт через JOIN на
  /// PresenterRecording.characterId и сортирует usedAt ПОПЕРЁК нескольких
  /// recordingId — там третья колонка лишь избавляет отдельные ветки JOIN'а от
  /// похода в heap за frameHash, полного index-only scan на запрос целиком
  /// она не даёт (не описываем выигрыш сильнее правды — Мелочи ревью
  /// фикс-раунда 1).
  /// Отдельный @@index([videoId]) убран тем же раундом: @@unique([videoId,
  /// sceneIndex]) уже B-tree с videoId ведущей колонкой и покрывает те же
  /// запросы — второй индекс был бы лишней записью на каждый insert.
  @@index([recordingId, usedAt, frameHash])
}
model SceneReferenceImage {
  id                  String    @id @default(cuid())
  sceneId             String
  scene               Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  // mood (атмосфера/палитра) | shot (композиция кадра) | environment (локация) | other
  kind                String    @default("mood")
  fileUrl             String
  storageKey          String?
  storageProvider     String    @default("gcs")
  sha1                String
  mimeType            String?
  bytes               Int?
  width               Int?
  height              Int?
  order               Int       @default(0)
  uploadedById        Int?
  createdAt           DateTime  @default(now())
  aiTags              String[]  @default([])
  aiCaption           String?
  // Расширенный визуальный prompt-инжектор (EN) — описание атмосферы/палитры/композиции,
  // которое composeScene склеит в финальный промпт сцены.
  aiVisualDescription String?
  aiAnalyzedAt        DateTime?
  aiError             String?
  aiAttempts          Int       @default(0)
  // Метаданные генерации через fal.ai (NULL для ручной загрузки)
  generationPrompt    String?
  generationModel     String?
  generationCostUsd   Decimal?  @db.Decimal(10, 6)

  @@unique([sceneId, sha1])
  @@index([sceneId, kind, order])
  @@index([aiAnalyzedAt])
}

// --- Scene Composer (F2) — блочный композитор сцены ---
//
// Scene = именованная сборка блоков (character/style/environment/action/app_context/app_screen)
// из которых compileScenePrompt() собирает финальный prompt + список референс-изображений.
// Уходит в существующий video-pipeline через shadow Scenario (trendId=null, sceneId=Scene.id).
// status: draft (правится) | ready (готова к генерации) | generating (видео в pipeline) | done.
model Scene {
  id                  String     @id @default(cuid())
  appId               Int
  app                 App        @relation(fields: [appId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  // SceneBlock[] — см. shared/types/scene.ts. Массив сохраняется как JSONB для гибкости
  // (добавление новых типов блоков без миграции). Валидация на API-уровне.
  blocks              Json
  // Скомпилированный текстовый промпт — обновляется при PUT /scenes/:id или POST /compile.
  promptCompiled      String?
  // Negative prompt (стиль, артефакты которых избегать) — отдельным полем, чтобы pipeline
  // мог использовать его как fal.ai parameter `negative_prompt` без парсинга основного.
  negativeCompiled    String?
  tags                String[]
  status              String     @default("draft")
  // Если сцена ушла в генерацию — сюда пишется id созданного Scenario (shadow без trendId).
  generatedScenarioId Int?
  archived            Boolean    @default(false)
  createdById         Int?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  scenarios           Scenario[]
  referenceImages     SceneReferenceImage[]

  @@index([appId, archived, updatedAt])
  @@index([status])
}

model AppReferenceImage {
  id              String    @id @default(cuid())
  appId           Int
  app             App       @relation(fields: [appId], references: [id], onDelete: Cascade)
  fileUrl         String // публичный URL картинки (/api/files/app-references/{appId}/{sha1}.{ext})
  sha1            String // первые 16 hex SHA1 контента — стабильный dedup-ключ
  mimeType        String? // image/png | image/jpeg | image/webp | image/gif
  bytes           Int?
  width           Int?
  height          Int?
  // GCS persistent storage. storageKey формата `zavodcamp/apps/{appId}/references/{sha1}.{ext}`.
  // fileUrl остаётся для backward compat 2 недели.
  storageKey      String?
  storageProvider String    @default("gcs")
  // --- AI-анализ скриншота (vision) ---
  aiTags          String[] // controlled vocabulary + freeform: ["login_screen", "dashboard", ...]
  aiCaption       String? // 1-2 предложения: что на скрине
  aiHasUI         Boolean? // true если экран — это UI приложения, false — сторонний контекст
  aiPrimaryAction String? // основной CTA / действие на экране
  aiAnalyzedAt    DateTime?
  aiError         String?
  aiAttempts      Int       @default(0)
  uploadedById    Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  shots           VideoShot[]

