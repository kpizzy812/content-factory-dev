model Scenario {
  id                  Int                        @id @default(autoincrement())
  // trendId стал nullable для поддержки scene-driven сценариев из SceneComposer (F2).
  // Когда null — это shadow Scenario, созданный POST /api/scenes/:id/generate, и sceneId
  // обязательно заполнен. Когда задан — классический trend-driven путь (CreativeBrief → Scenario).
  trendId             Int?
  trend               Trend?                     @relation(fields: [trendId], references: [id], onDelete: Cascade)
  hypothesisId        String?
  hypothesis          ContentHypothesis?         @relation(fields: [hypothesisId], references: [id], onDelete: SetNull)
  briefId             Int?
  appId               Int?
  // sceneId — обратная ссылка на исходную Scene из SceneComposer. onDelete: SetNull
  // сохраняет историю сгенерированных Scenario при удалении исходной сцены.
  sceneId             String?
  scene               Scene?                     @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  profileId           Int?
  profile             ScenarioGenerationProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  status              ScenarioStatus             @default(draft)
  selectedVariantId   Int?
  generationStatus    String?
  operatorNotes       String?
  reworkRequest       String?
  sourceBriefVersion  String?
  sourcePromptVersion String?
  isDeleted           Boolean                    @default(false)
  deletedAt           DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  // --- Pipeline tracking (nullable, for standalone/pipeline separation) ---
  runId               Int?
  run                 WorkflowRun?               @relation(fields: [runId], references: [id], onDelete: SetNull)
  pipelineId          Int?
  pipeline            Pipeline?                  @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  variants            ScenarioVariant[]
  reviewActions       ScenarioReviewAction[]
  videos              Video[]
  feedbacks           ScenarioFeedback[]
  criticReviews       CriticReview[]
  factoryQaReviews    FactoryQualityReview[]

  @@index([trendId, isDeleted])
  @@index([hypothesisId, isDeleted])
  @@index([status, isDeleted])
  @@index([runId])
  @@index([pipelineId])
  @@index([sceneId])
}

model ScenarioVariant {
