# Шаблон test environment. Скопируй в .env.test и подставь реальные значения.
# Реальный .env.test — НЕ коммитится (правило в .gitignore: .env.*).
#
# Сгенерируй секреты:
#   ENCRYPTION_KEY:   openssl rand -hex 32
#   TEST_AUTH_TOKEN:  openssl rand -hex 32
#
# Test PostgreSQL поднимается отдельным Docker-контейнером на порту 5436.
# tests/setup.ts блокирует прогон, если DATABASE_URL не указывает на test DB
# (порт 5436 + имя БД содержит "tests").

NODE_ENV=test
DATABASE_URL=postgresql://Zavod_admin_tests:Zavod_admin_password_tests@localhost:5436/Zavod_camp_app_tests_db
NUXT_SESSION_PASSWORD=test-test-test-test-test-test-test-32
ENCRYPTION_KEY=<openssl rand -hex 32>
MARKETING_CAMP_URL=http://localhost:3001
INTER_SERVICE_API_KEY=test-inter-service
ZAVOD_API_KEY=test-zavod-api-key

ANTHROPIC_API_KEY=
FAL_KEY=
MUBERT_KEY=
APIFY_TOKEN=
TELEGRAM_BOT_TOKEN=

ENABLE_PAID_APIS=false
ENABLE_SOCIAL_POSTING=false
SCHEDULERS_ENABLED=false
POSTING_WORKER_ENABLED=false
PROXY_HEALTH_CHECK_ENABLED=false

PROXY_MOCK_MODE=true
ANTHROPIC_MOCK_MODE=true
FAL_MOCK_MODE=true
TELEGRAM_MOCK_MODE=true

TEST_AUTH_BYPASS=1
TEST_AUTH_TOKEN=<openssl rand -hex 32>
