# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs (только корневая директория /logs — иначе ловит app/pages/admin/logs/
# и server/api/admin/logs/, и страница админки никогда не коммитится).
/logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example
!.env.test.example

# Storage (generated files)
storage/uploads/
storage/frames/*
!storage/frames/.gitkeep
# Локальный драйвер хранилища пишет сюда на прогонах API-сьют (localRoot='./storage')
storage/zavodcamp/
# Сырые записи ведущей: гигабайты, в git им делать нечего
storage/raw/

# Playwright MCP artifacts
.playwright-mcp-output/
screens/

# Test artifacts
tests/playwright-report/
tests/test-results/
tests/.cache/
tests/visual/screenshots/
coverage/
.vitest-cache/

# Harness: регенерируемый граф (./harness graph пересобирает; зеркалится в SQLite)
graphify-out/
graphify-cache/

# Design: архив-исходник, содержимое распаковано в design-preview/catalog
docs/design/*.zip

# Артефакты Playwright MCP и скриншоты проверок
.playwright-mcp/
/*.png
