# syntax=docker/dockerfile:1.7
FROM oven/bun:1

WORKDIR /app

# Build dependencies must stay available even when Saturn injects NODE_ENV=production.
ENV NODE_ENV=development

COPY package.json bun.lock* ./
COPY prisma ./prisma/
RUN bun install --frozen-lockfile

COPY . .
RUN DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy" bunx prisma generate
RUN bun run build

# Install media runtime only after the Nuxt build so BuildKit cannot run both
# memory-heavy steps in parallel on the development builder.
# ffmpeg — сборка ролика. Остальное — системные библиотеки headless Chrome,
# который Remotion скачивает себе сам, но запустить без них не может:
# «libnspr4.so: cannot open shared object file». Ролик при этом собирался, а
# инфографика молча пропускалась — дефект был виден только в логе шага сборки.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl ffmpeg \
      libnspr4 libnss3 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
      libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
      libgbm1 libasound2 libpango-1.0-0 libcairo2 fonts-liberation \
 && rm -rf /var/lib/apt/lists/*

# Claude Code CLI — транспорт LLM через OAuth-подписку (LLM_TRANSPORT=claude_cli).
# Ставится всегда, включается переменной: без неё контур идёт по API-ключу.
# Отдельный HOME, чтобы в генерацию не подмешивались чужие CLAUDE.md и хуки.
RUN bun install -g @anthropic-ai/claude-code \
 && mkdir -p /app/.claude-home
ENV CLAUDE_CLI_HOME=/app/.claude-home

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

RUN mkdir -p /app/storage/uploads /app/storage/frames \
 && chmod 755 /app/storage \
 && chmod +x /app/entrypoint.sh

VOLUME /app/storage/uploads
VOLUME /app/storage/frames
EXPOSE 3000

CMD ["./entrypoint.sh"]