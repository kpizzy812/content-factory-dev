{
  "name": "content-factory",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "mock:proxy": "tsx server/__mocks__/proxy-server.ts",
    "mock:drive": "bun run server/__mocks__/google-drive-server.ts",
    "mock:duoplus": "tsx server/__mocks__/duoplus-server.ts",
    "mock:all": "tsx server/__mocks__/proxy-server.ts",
    "create:admin": "bun run scripts/create-admin.ts",
    "seed:warmup": "bun run scripts/seed-warmup-keywords.ts",
    "seed:drive-template": "bun run scripts/seed-drive-pipeline-template.ts",
    "test:warmup": "bun run scripts/test-warmup-planner.ts",
    "test:uniqifier": "bun run scripts/test-uniqifier.ts",
    "check:remotion": "bun run scripts/check-remotion-bundle.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:api": "vitest run tests/api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:db:migrate": "bash -c 'set -a && source ./.env.test && set +a && bunx prisma migrate deploy'",
    "test:db:reset": "bash -c 'set -a && source ./.env.test && set +a && bunx prisma migrate reset --force --skip-seed'"
  },
