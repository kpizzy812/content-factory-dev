# ═══════════════════════════════════════════════════════════════════════════
# ZavodCamp — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Скопировать в .env (dev/prod). Production деплой — см. Dockerfile + entrypoint.sh.
#
# Поднимать:
#   1. Сгенерировать секреты: openssl rand -hex 32  (×3: SESSION, ENCRYPTION, ZAVOD_API_KEY)
#   2. ZAVOD_API_KEY должен быть ИДЕНТИЧЕН в .env MarketingCamp — это shared secret.
#   3. ENCRYPTION_KEY: ровно 64 hex-символа = 32 байта для AES-256-GCM.
#      ВНИМАНИЕ: при потере все зашифрованные данные (SocialAccount.loginPassword,
#      Proxy.host/username/password, OAuth токены) станут невосстановимы.
#      Production и dev — РАЗНЫЕ ключи, prod хранить в password manager.
# ═══════════════════════════════════════════════════════════════════════════

# ─── REQUIRED (deploy не запустится без этих) ──────────────────────────────

# Среда: production включает Secure cookie flag, выключает devtools.
NODE_ENV=production

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/zavodcamp

# nuxt-auth-utils: секрет для шифрования сессий (минимум 32 символа).
# openssl rand -hex 32
NUXT_SESSION_PASSWORD=

# Ключ шифрования секретов (32 байта в hex = ровно 64 символа).
# openssl rand -hex 32
ENCRYPTION_KEY=

# Isolated development login. Ignored unless both flags are exact.
CONTENT_FACTORY_ENV=production
DEV_AUTH_ENABLED=false
DEV_AUTH_EMAIL=
DEV_AUTH_PASSWORD=

# ─── REQUIRED для логина (интеграция с MarketingCamp) ──────────────────────

# URL родительской платформы (без trailing slash).
# Используется для POST /api/auth/validate-external при логине пользователя
# и для всех двусторонних обменов creatives/ideas.
MARKETING_CAMP_URL=https://marketingcamp.example.com

# X-Service-Key: ZavodCamp подписывает им исходящие запросы валидации логина к MC.
# Нужен только в ZavodCamp.
INTER_SERVICE_API_KEY=change-me-to-a-secure-api-key

# Bearer token: общий shared secret для двустороннего обмена /api/zavod/*.
# ОБЯЗАТЕЛЬНО ИДЕНТИЧЕН переменной ZAVOD_API_KEY в .env MarketingCamp.
ZAVOD_API_KEY=change-me-to-a-secure-zavod-api-key

# ─── AI (Anthropic) ────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Модель Anthropic для сложных задач (block-level AI, сценарии, critic).
ANTHROPIC_MODEL=claude-sonnet-4-6

# Модель Anthropic Haiku для лёгких задач (field-level suggest, keywords, tags).
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# ─── External APIs ─────────────────────────────────────────────────────────

# fal.ai — генерация изображений и видео.
FAL_KEY=your-fal-ai-key

# Replicate — основной медиапровайдер ContentFactory.
# Получить API token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# Signing secret из Replicate webhook settings. Никогда не передавать на клиент.
REPLICATE_WEBHOOK_SIGNING_SECRET=
# Публичный origin приложения без пути, например https://factory.example.com.
REPLICATE_WEBHOOK_BASE_URL=
# Канонический публичный origin ContentFactory. Используется OAuth redirect и
# временными подписанными ссылками, по которым Meta забирает Reel.
CONTENT_FACTORY_PUBLIC_URL=
# Отдельные секреты опциональны; fallback — NUXT_SESSION_PASSWORD.
PUBLIC_MEDIA_SIGNING_SECRET=
SOCIAL_OAUTH_STATE_SECRET=
REPLICATE_DEFAULT_LIPSYNC_MODEL=kwaivgi/kling-lip-sync
# Recovery-поллинг подхватывает jobs, для которых webhook потерялся. Default: true.
REPLICATE_RECOVERY_ENABLED=true
# fal.ai используется только как явный fallback. Пусто = fallback отключён.
MEDIA_PROVIDER_FALLBACK=

# Mubert — генерация музыки.
MUBERT_KEY=your-mubert-api-key

# Apify — парсинг трендов (TikTok/YouTube/Instagram actors).
# Также используется балансом /admin/balances и Telegram /balance (auto-fetch через /v2/users/me).
APIFY_TOKEN=your-apify-token

# NodeMaven — резидентный прокси-провайдер. Не используется в runtime пайплайнов (там
# proxy creds приходят из БД), нужен только для /admin/balances auto-fetch через
# https://dashboard.nodemaven.com/api/v2/users/me. Без ключа провайдер падает в
# manual fallback (читает последний ServiceBalanceEntry).
# NODEMAVEN_API_KEY=

# ─── TTS (опционально, дефолты прошиты в nuxt.config.ts) ──────────────────

# Default TTS модель (через fal.ai).
DEFAULT_TTS_MODEL_ID=fal-ai/kokoro/american-english
DEFAULT_TTS_VOICE_EN=af_heart
DEFAULT_TTS_VOICE_RU=bf_emma

# ElevenLabs API key — используется только если выбран ElevenLabs voice.
ELEVENLABS_API_KEY=

# Включить voiceover в новых пайплайнах по умолчанию (per-pipeline override доступен).
ENABLE_VOICEOVER_BY_DEFAULT=false

# ─── Safety switches: платные API и публикация ────────────────────────────

# Предохранитель: платные API (Anthropic, fal.ai, Mubert) выключены по умолчанию.
# На первый деплой оставить false, включить когда убедились что mock'и работают.
ENABLE_PAID_APIS=false

# Предохранитель: публикация в YouTube/TikTok/Instagram отключена.
ENABLE_SOCIAL_POSTING=false

# ─── Social platforms credentials (используются если ENABLE_SOCIAL_POSTING=true) ─

# YouTube OAuth 2.0
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram API with Instagram Login (Business/Creator).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Версия фиксируется, чтобы обновление Meta не меняло контракт молча.
INSTAGRAM_GRAPH_API_VERSION=v25.0
# OAuth redirect в Meta Dashboard:
# https://factory.example.com/api/social/callback/instagram

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# ─── Schedulers (интервалы в мс, дефолты в nuxt.config.ts) ────────────────

# Upload/metrics/cycle scheduler (server/plugins/scheduler.ts)
SCHEDULER_UPLOAD_INTERVAL_MS=300000
SCHEDULER_METRICS_INTERVAL_MS=3600000
SCHEDULER_CYCLE_CHECK_INTERVAL_MS=21600000
SCHEDULER_CYCLE_TIMEOUT_MS=1800000

# Reference watchdog (отлавливает зависшие референсы).
SCHEDULER_REFERENCE_WATCHDOG_INTERVAL_MS=300000
SCHEDULER_REFERENCE_WATCHDOG_TIMEOUT_MS=600000

# ─── Унаследованный контур VideoCamp ───────────────────────────────────────
# Все зоны выключены по умолчанию. Включение — только значением ровно "true".
# Выключенная зона отдаёт 404 на своих API и не показывается в навигации.
# Удалять код зон нельзя, пока официальная замена не подтверждена на живом
# аккаунте (docs/superpowers/specs/2026-07-22-content-factory-design.md, §13 шаг 10).
# Подробности: docs/operations/legacy-contour.md
LEGACY_DEVICE_AUTOMATION_ENABLED=false
LEGACY_PROXY_POOL_ENABLED=false
LEGACY_GOOGLE_DRIVE_ENABLED=false
LEGACY_MARKETING_CAMP_SYNC_ENABLED=false

# Proxy health check (Social Automation).
# Работает только внутри включённой зоны, см. LEGACY_PROXY_POOL_ENABLED выше.
PROXY_HEALTH_CHECK_ENABLED=true
SCHEDULER_PROXY_HEALTH_INTERVAL_MS=14400000
SCHEDULER_PROXY_HEALTH_STALE_MS=14400000

# Posting worker (FSM PostingJob, Track D).
# Работает только внутри включённой зоны, см. LEGACY_DEVICE_AUTOMATION_ENABLED выше.
POSTING_WORKER_ENABLED=true
SCHEDULER_POSTING_INTERVAL_MS=30000
# DEV/TEST-ONLY: мок API-раннера (фейкает «published» с mock-post URL).
# В проде НЕ ставить — реального API-раннера нет (IG/TikTok постят только через
# browser_automation). При false/unset api-джоба валится терминально (internal_error).
# POSTING_MOCK_RUNNER=false

# ─── Reference processing thresholds ──────────────────────────────────────

REFERENCE_THRESHOLD_VIEWS=10000
REFERENCE_THRESHOLD_WATCH_THROUGH=50

# ─── Deployment helpers ────────────────────────────────────────────────────

# Override пути к yt-dlp бинарю. Дефолт в Docker — /usr/local/bin/yt-dlp,
# вне Docker — поиск в PATH и системных путях.
# YT_DLP_BIN_PATH=/usr/local/bin/yt-dlp

# Запустить prisma/seed.ts на старте контейнера если БД пустая.
# Применимо только в entrypoint.sh при первом деплое.
# RUN_SEED=true

# ─── Mock Mode (для разработки и тестов без реальных внешних API) ──────────
# Каждый флаг изолирует ровно одну интеграцию. Можно включать выборочно.
# Подробности — docs/architecture/social_automation.md (раздел Mock Development).
#
# Прокси: checkProxy() возвращает синтетический результат на основе host прокси
# ("mock-happy_path", "mock-leak", "mock-auth_failed", "mock-timeout" и т.п.).
# Standalone HTTP-mock (для прямых вызовов IP-info) — `npm run mock:proxy`.
# PROXY_MOCK_MODE=true
# PROXY_MOCK_URL=http://localhost:18888
#
# DuoPlus — облачный провайдер устройств/постинга (Этап 2 миграции, заменяет Indigo/Multilogin X).
# - DUOPLUS_API_KEY — ключ доступа к OpenAPI. ТОЛЬКО в secret store деплоя (Saturn secrets), НЕ коммитить.
# - DUOPLUS_API_BASE — базовый URL OpenAPI (переопределять редко).
# Читаются server-only через process.env (НЕ в runtimeConfig.public).
DUOPLUS_API_KEY=
DUOPLUS_API_BASE=https://openapi.duoplus.net
# - DUOPLUS_ENGINE_ENABLED — канареечный гейт реального DuoPlus-движка постинга
#   (Этап 3, P5). Default OFF: browser_automation-джобы валятся terminal
#   engine_not_implemented (как Этап 2). Включать ТОЧЕЧНО после прогона живой
#   канарейки (1 успешная джоба end-to-end на проде). "true" → AdbAutomationEngine.
DUOPLUS_ENGINE_ENABLED=false
#
# Anthropic — все agent-вызовы возвращают фикстуры из server/__fixtures__/agents/.
# Агенты без agentName в callAnthropicAgent падают с понятной ошибкой.
# ANTHROPIC_MOCK_MODE=true
#
# fal.ai — submit/poll возвращают синтетический result, downloadFile генерит
# placeholder MP4/MP3/PNG через ffmpeg в storage/uploads/_mock_cache/.
# FAL_MOCK_MODE=true
#
# Replicate — детерминированные prediction id/status/output без сетевых вызовов.
# REPLICATE_MOCK_MODE=true
#
# Telegram — sendMessage/editMessage логируют в stdout, message_id синтетический.
# TELEGRAM_MOCK_MODE=true

# ─── Scenario Quality Critic ──────────────────────────────────────────────
# AI-критик после генерации сравнивает N вариантов сценария по 6 критериям,
# при needsRework делает rework через regenerateBlock('fullScript') до 2 итераций,
# auto-выбирает лучший variant если оператор ещё не выбрал.
# Default: true. Cost: ~$0.02-0.15 за scenario в зависимости от rework loop.
# SCENARIO_CRITIC_ENABLED=true
#
# Mock-режим переключения между happy и rework фикстурой (требует ANTHROPIC_MOCK_MODE=true).
# Значения: '' (default → happy) / 'rework' (загрузит scenario-quality-critic-rework-happy.json).
# CRITIC_MOCK_VARIANT=

# ─── Test infrastructure (активны только при NODE_ENV=test) ───────────────
# Гасит все 4 scheduler-плагина (upload/metrics/cycle, trendwatcher, pipeline, telegram).
# В .env.test ставь SCHEDULERS_ENABLED=false. В production не активируется.
# SCHEDULERS_ENABLED=true
#
# Test-only bypass авторизации через заголовки x-test-auth-token и x-test-user-id.
# Активен ТОЛЬКО при NODE_ENV !== "production". Без TEST_AUTH_TOKEN не работает.
# TEST_AUTH_BYPASS=
# TEST_AUTH_TOKEN=

# ─── Google Drive integration (Stage 1) ───────────────────────────────────
# Scheduler tick для refresh metadata DriveFile (default 30m). false отключит.
# Работает только внутри включённой зоны, см. LEGACY_GOOGLE_DRIVE_ENABLED выше.
# GOOGLE_DRIVE_SCHEDULER_ENABLED=true
# SCHEDULER_GOOGLE_DRIVE_INTERVAL_MS=1800000
#
# Mock-режим: standalone HTTP сервер на 18889 эмулирует Drive REST v3.
# Запуск: bun run mock:drive
# GOOGLE_DRIVE_MOCK_MODE=false
# GOOGLE_DRIVE_MOCK_URL=http://localhost:18889
#
# Лимит на размер скачиваемого файла (default 500MB).
# GOOGLE_DRIVE_MAX_DOWNLOAD_BYTES=524288000

# ─── Persistent storage ────────────────────────────────────────────────────

# Driver: 'gcs' (prod, default при NODE_ENV=production), 'local' (dev FS),
# 'mock' (tests, in-memory). Если не задано — auto: production→gcs, иначе→local.
# STORAGE_DRIVER=local

# Local driver: корень FS. STORAGE_LOCAL_ROOT — primary. UPLOADS_STORAGE_PATH —
# legacy alias, поддерживается для backward compat со старой инфраструктурой.
# Без обоих — `./storage` относительно cwd. Все ключи (zavodcamp/videos/{id}/...)
# мапятся ВНУТРЬ этого корня.
# STORAGE_LOCAL_ROOT=./storage

# GCS driver (required если STORAGE_DRIVER=gcs или NODE_ENV=production без явного
# override). Bucket shared с MarketingCamp, ZavodCamp пишет ТОЛЬКО под префиксом
# zavodcamp/ — PrefixGuard блокирует выходы за этот префикс.
# GCS_PROJECT_ID=marketingcamp-drive
# GCS_BUCKET_NAME=marketingcamp-creatives

# GCS credentials — три способа, проверяются в порядке приоритета:
#
# 1) GCS_CREDENTIALS_JSON_BASE64 (PRIMARY, prod на Saturn/Render/Fly): base64
#    от service account JSON. Решает реальную проблему PaaS UI которые мангалят
#    escape sequences в plain JSON (\n внутри private_key превращается в literal n
#    и JSON.parse падает с "Unrecognized token '\'"). base64 транспортирует байты
#    as-is, безопасно через любой env-var интерфейс.
#    Сгенерировать: `base64 -w0 < your-service-account.json | xclip -selection clipboard`
#    (macOS: `base64 < your-key.json | tr -d '\n' | pbcopy`)
# GCS_CREDENTIALS_JSON_BASE64=
#
# 2) GCS_CREDENTIALS_JSON (если PaaS UI не ломает escapes): минифицированный JSON.
#    Сгенерировать: `jq -c . < your-service-account.json | xclip -selection clipboard`
#    Работает локально через .env, на Saturn UI — нет (см. base64 выше).
# GCS_CREDENTIALS_JSON=
#
# 3) GOOGLE_APPLICATION_CREDENTIALS (FALLBACK, dev): путь к файлу service account.
#    Стандарт Google Cloud SDK — удобно для локальной разработки.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Legacy persistent storage envs (используются LocalDriver если STORAGE_LOCAL_ROOT
# не задан). При деплое на saturn.ac/Render/Fly: VOLUME в Dockerfile сам по себе
# НЕ даёт persistent disk — нужно через дашборд платформы привязать persistent
# disk к точке монтирования. С GCS-driver (production по умолчанию) эта проблема
# уходит — файлы живут в bucket навсегда.
# UPLOADS_STORAGE_PATH=/app/storage/uploads

# Persistent директория для извлечённых кадров (default `storage/frames` от cwd,
# в Docker = /app/storage/frames с volume mount). Кадры эфемерны — регенерируемы
# из исходного видео через ffmpeg, в GCS НЕ мигрируются.
# FRAME_STORAGE_PATH=storage/frames

STORAGE_DRIVER=gcs
GCS_PROJECT_ID=marketingcamp-drive
GCS_BUCKET_NAME=marketingcamp-creatives
GCS_CREDENTIALS_JSON=<минифицированный JSON, в .env.local>

# ChatPlace MCP - creation/update of a funnel after a post is published.
# ChatPlace Pro and an API key from ChatPlace settings are required. Live calls are off by default.
ENABLE_AUTOMATION_SYNC=false
CHATPLACE_API_KEY=
CHATPLACE_MCP_URL=https://mcp.chatplace.io/mcp
CHATPLACE_AUTH_HEADER=Authorization
CHATPLACE_AUTH_SCHEME=Bearer
CHATPLACE_MCP_PROTOCOL_VERSION=2025-03-26
# Optional exact MCP tool name after GET /api/factory/integrations/chatplace/status?discover=true
CHATPLACE_MCP_TOOL=
